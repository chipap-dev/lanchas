# Copiar a .env antes de levantar con docker-compose.

# Credenciales del servicio Postgres del docker-compose (se arma DATABASE_URL solo)
POSTGRES_DB=lanchas
POSTGRES_USER=lanchas
POSTGRES_PASSWORD=lanchas

SECRET_KEY=change-me
DEBUG=True

# Opcional: crea un superusuario de Django al levantar (dejar vacio para saltear)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Opcional: token para el endpoint /cron/actualizar/ (no se usa en local)
CRON_SECRET_LANCHAS=
